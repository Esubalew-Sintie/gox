package {{ .Snake }}

{{- if .Storage.Postgres }}
import "database/sql"

type Persistence struct {
	DB *sql.DB
}
{{- end }}

type Module struct {
	Handler *Handler
}

func New({{- if .Storage.Postgres }}db *sql.DB{{- end }}) Module {
	repo := NewRepository({{- if .Storage.Postgres }}db{{- end }})
	service := NewService(repo)
	handler := NewHandler(service)

	return Module{
		Handler: handler,
	}
}
