	"go.mongodb.org/mongo-driver/bson"
	"go.mongodb.org/mongo-driver/mongo"
)

type repository struct {
	collection *mongo.Collection
}

func Init(database *mongo.Database) (persistence.{{ .Pascal }}, error) {
	if database == nil {
		return nil, fmt.Errorf("mongo database is required")
	}
	return &repository{collection: database.Collection("{{ .Snake }}")}, nil
}

func (r *repository) Create(input dto.Create{{ .Pascal }}Request) entity.{{ .Pascal }} {
	item := entity.{{ .Pascal }}{ID: newID(), Name: input.Name, CreatedAt: now(), UpdatedAt: now()}
	if _, err := r.collection.InsertOne(context.Background(), item); err != nil {
		panic(fmt.Errorf("insert {{ .Snake }}: %w", err))
	}
	return item
}

func (r *repository) List() []entity.{{ .Pascal }} {
	cursor, err := r.collection.Find(context.Background(), bson.M{})
	if err != nil {
		panic(fmt.Errorf("list {{ .Snake }}: %w", err))
	}
	defer cursor.Close(context.Background())

	items := make([]entity.{{ .Pascal }}, 0)
	if err := cursor.All(context.Background(), &items); err != nil {
		panic(fmt.Errorf("decode {{ .Snake }} list: %w", err))
	}
	return items
}

func (r *repository) Get(id string) (entity.{{ .Pascal }}, bool) {
	var item entity.{{ .Pascal }}
	if err := r.collection.FindOne(context.Background(), bson.M{"id": id}).Decode(&item); err != nil {
		return entity.{{ .Pascal }}{}, false
	}
	return item, true
}

func (r *repository) Update(id string, input dto.Update{{ .Pascal }}Request) (entity.{{ .Pascal }}, bool) {
	result, err := r.collection.UpdateOne(context.Background(), bson.M{"id": id}, bson.M{"$set": bson.M{"name": input.Name, "updated_at": now()}})
	if err != nil {
		panic(fmt.Errorf("update {{ .Snake }}: %w", err))
	}
	if result.MatchedCount == 0 {
		return entity.{{ .Pascal }}{}, false
	}
	return r.Get(id)
}

func (r *repository) Delete(id string) bool {
	result, err := r.collection.DeleteOne(context.Background(), bson.M{"id": id})
	if err != nil {
		panic(fmt.Errorf("delete {{ .Snake }}: %w", err))
	}
	return result.DeletedCount > 0
}
{{ else }}
import (
	"fmt"
	"sync"
	"sync/atomic"
	"time"

	dto "{{ .ModulePath }}/internal/constant/dto"
	entity "{{ .ModulePath }}/internal/constant/entities/{{ .Snake }}"
	persistence "{{ .ModulePath }}/internal/storage/persistence"
)

type repository struct {
	mu     sync.RWMutex
	nextID uint64
	items  map[string]entity.{{ .Pascal }}
}

func Init() (persistence.{{ .Pascal }}, error) {
	return &repository{items: make(map[string]entity.{{ .Pascal }})}, nil
}

func (r *repository) Create(input dto.Create{{ .Pascal }}Request) entity.{{ .Pascal }} {
	now := time.Now().UTC()
	item := entity.{{ .Pascal }}{
		ID: fmt.Sprintf("{{ .Kebab }}-%d", atomic.AddUint64(&r.nextID, 1)),
		Name: input.Name, CreatedAt: now, UpdatedAt: now,
	}
	r.mu.Lock()
	r.items[item.ID] = item
	r.mu.Unlock()
	return item
}

func (r *repository) List() []entity.{{ .Pascal }} {
	r.mu.RLock()
	defer r.mu.RUnlock()
	items := make([]entity.{{ .Pascal }}, 0, len(r.items))
	for _, item := range r.items {
		items = append(items, item)
	}
	return items
}

func (r *repository) Get(id string) (entity.{{ .Pascal }}, bool) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	item, ok := r.items[id]
	return item, ok
}

func (r *repository) Update(id string, input dto.Update{{ .Pascal }}Request) (entity.{{ .Pascal }}, bool) {
	r.mu.Lock()
	defer r.mu.Unlock()
	item, ok := r.items[id]
	if !ok {
		return entity.{{ .Pascal }}{}, false
	}
	item.Name = input.Name
	item.UpdatedAt = time.Now().UTC()
	r.items[id] = item
	return item, true
}

func (r *repository) Delete(id string) bool {
	r.mu.Lock()
	defer r.mu.Unlock()
	if _, ok := r.items[id]; !ok {
		return false
	}
	delete(r.items, id)
	return true
}
