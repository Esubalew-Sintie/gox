package {{ .Snake }}

{{ if eq .Storage.Driver "postgres" }}
import (
	"context"
	"fmt"
	"time"

	dto "{{ .ModulePath }}/internal/constant/dto"
	entity "{{ .ModulePath }}/internal/constant/entities/{{ .Snake }}"
	persistence "{{ .ModulePath }}/internal/storage/persistence"
	"github.com/jackc/pgx/v5/pgxpool"
)

type repository struct {
	pool *pgxpool.Pool
}

func Init(pool *pgxpool.Pool) (persistence.{{ .Pascal }}, error) {
	if pool == nil {
		return nil, fmt.Errorf("postgres pool is required")
	}
	return &repository{pool: pool}, nil
}

func (r *repository) Create(input dto.Create{{ .Pascal }}Request) entity.{{ .Pascal }} {
	item := entity.{{ .Pascal }}{ID: newID(), Name: input.Name, CreatedAt: now(), UpdatedAt: now()}
	_, err := r.pool.Exec(context.Background(), "INSERT INTO {{ .Snake }} (id, name, created_at, updated_at) VALUES ($1, $2, $3, $4)", item.ID, item.Name, item.CreatedAt, item.UpdatedAt)
	if err != nil {
		panic(fmt.Errorf("insert {{ .Snake }}: %w", err))
	}
	return item
}

func (r *repository) List() []entity.{{ .Pascal }} {
	rows, err := r.pool.Query(context.Background(), "SELECT id, name, created_at, updated_at FROM {{ .Snake }} ORDER BY created_at")
	if err != nil {
		panic(fmt.Errorf("list {{ .Snake }}: %w", err))
	}
	defer rows.Close()

	items := make([]entity.{{ .Pascal }}, 0)
	for rows.Next() {
		var item entity.{{ .Pascal }}
		if err := rows.Scan(&item.ID, &item.Name, &item.CreatedAt, &item.UpdatedAt); err != nil {
			panic(fmt.Errorf("scan {{ .Snake }}: %w", err))
		}
		items = append(items, item)
	}
	if err := rows.Err(); err != nil {
		panic(fmt.Errorf("iterate {{ .Snake }}: %w", err))
	}
	return items
}

func (r *repository) Get(id string) (entity.{{ .Pascal }}, bool) {
	var item entity.{{ .Pascal }}
	err := r.pool.QueryRow(context.Background(), "SELECT id, name, created_at, updated_at FROM {{ .Snake }} WHERE id = $1", id).Scan(&item.ID, &item.Name, &item.CreatedAt, &item.UpdatedAt)
	if err != nil {
		return entity.{{ .Pascal }}{}, false
	}
	return item, true
}

func (r *repository) Update(id string, input dto.Update{{ .Pascal }}Request) (entity.{{ .Pascal }}, bool) {
	var item entity.{{ .Pascal }}
	err := r.pool.QueryRow(context.Background(), "UPDATE {{ .Snake }} SET name = $1, updated_at = NOW() WHERE id = $2 RETURNING id, name, created_at, updated_at", input.Name, id).Scan(&item.ID, &item.Name, &item.CreatedAt, &item.UpdatedAt)
	if err != nil {
		return entity.{{ .Pascal }}{}, false
	}
	return item, true
}

func (r *repository) Delete(id string) bool {
	tag, err := r.pool.Exec(context.Background(), "DELETE FROM {{ .Snake }} WHERE id = $1", id)
	if err != nil {
		panic(fmt.Errorf("delete {{ .Snake }}: %w", err))
	}
	return tag.RowsAffected() > 0
}
