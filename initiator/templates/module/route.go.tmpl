package {{ .Snake }}

import (
{{ if eq .HTTP "net/http" }}
	"net/http"
{{ else if eq .HTTP "chi" }}
	"github.com/go-chi/chi/v5"
{{ else }}
	"github.com/gin-gonic/gin"
{{ end }}

	rest "{{ .ModulePath }}/internal/handler/rest"
)

func InitRoutes(router {{ if eq .HTTP "net/http" }}*http.ServeMux{{ else if eq .HTTP "chi" }}chi.Router{{ else }}gin.IRouter{{ end }}, h rest.{{ .Pascal }}) {
{{ if eq .HTTP "net/http" }}
	router.HandleFunc("POST /{{ .Plural }}", h.Create)
	router.HandleFunc("GET /{{ .Plural }}", h.List)
	router.HandleFunc("GET /{{ .Plural }}/{id}", h.Get)
	router.HandleFunc("PUT /{{ .Plural }}/{id}", h.Update)
	router.HandleFunc("DELETE /{{ .Plural }}/{id}", h.Delete)
	router.HandleFunc("GET /{{ .Plural }}/health", h.Health)
{{ else if eq .HTTP "chi" }}
	router.Post("/{{ .Plural }}", h.Create)
	router.Get("/{{ .Plural }}", h.List)
	router.Get("/{{ .Plural }}/{id}", h.Get)
	router.Put("/{{ .Plural }}/{id}", h.Update)
	router.Delete("/{{ .Plural }}/{id}", h.Delete)
	router.Get("/{{ .Plural }}/health", h.Health)
{{ else }}
	router.POST("/{{ .Plural }}", func(c *gin.Context) { h.Create(c.Writer, c.Request) })
	router.GET("/{{ .Plural }}", func(c *gin.Context) { h.List(c.Writer, c.Request) })
	router.GET("/{{ .Plural }}/:id", func(c *gin.Context) { h.Get(c.Writer, c.Request) })
	router.PUT("/{{ .Plural }}/:id", func(c *gin.Context) { h.Update(c.Writer, c.Request) })
	router.DELETE("/{{ .Plural }}/:id", func(c *gin.Context) { h.Delete(c.Writer, c.Request) })
	router.GET("/{{ .Plural }}/health", func(c *gin.Context) { h.Health(c.Writer, c.Request) })
{{ end }}
}
