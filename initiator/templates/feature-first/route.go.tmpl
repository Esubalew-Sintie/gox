package {{ .Snake }}

{{ if eq .HTTP "net/http" }}
import "net/http"
{{ else if eq .HTTP "chi" }}
import "github.com/go-chi/chi/v5"
{{ else }}
import "github.com/gin-gonic/gin"
{{ end }}

func RegisterRoutes(router {{ if eq .HTTP "net/http" }}*http.ServeMux{{ else if eq .HTTP "chi" }}chi.Router{{ else }}gin.IRouter{{ end }}, handler *Handler) {
{{ if eq .HTTP "net/http" }}
	router.HandleFunc("POST /{{ .Plural }}", handler.Create)
	router.HandleFunc("GET /{{ .Plural }}", handler.List)
	router.HandleFunc("GET /{{ .Plural }}/{id}", handler.Get)
	router.HandleFunc("PUT /{{ .Plural }}/{id}", handler.Update)
	router.HandleFunc("DELETE /{{ .Plural }}/{id}", handler.Delete)
	router.HandleFunc("GET /{{ .Plural }}/health", handler.Health)
{{ else if eq .HTTP "chi" }}
	router.Post("/{{ .Plural }}", handler.Create)
	router.Get("/{{ .Plural }}", handler.List)
	router.Get("/{{ .Plural }}/{id}", handler.Get)
	router.Put("/{{ .Plural }}/{id}", handler.Update)
	router.Delete("/{{ .Plural }}/{id}", handler.Delete)
	router.Get("/{{ .Plural }}/health", handler.Health)
{{ else }}
	router.POST("/{{ .Plural }}", func(c *gin.Context) { handler.Create(c.Writer, c.Request) })
	router.GET("/{{ .Plural }}", func(c *gin.Context) { handler.List(c.Writer, c.Request) })
	router.GET("/{{ .Plural }}/:id", func(c *gin.Context) { handler.Get(c.Writer, c.Request) })
	router.PUT("/{{ .Plural }}/:id", func(c *gin.Context) { handler.Update(c.Writer, c.Request) })
	router.DELETE("/{{ .Plural }}/:id", func(c *gin.Context) { handler.Delete(c.Writer, c.Request) })
	router.GET("/{{ .Plural }}/health", func(c *gin.Context) { handler.Health(c.Writer, c.Request) })
{{ end }}
}
