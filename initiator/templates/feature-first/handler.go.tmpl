package {{ .Snake }}

import (
	"encoding/json"
	"net/http"
	"strings"

	apperrors "{{ .ModulePath }}/internal/constant/errors"
	"{{ .ModulePath }}/internal/constant/response"
)

type Handler struct{ service *Service }

func NewHandler(service *Service) *Handler { return &Handler{service: service} }

func (h *Handler) Create(w http.ResponseWriter, r *http.Request) {
	var input Create{{ .Pascal }}Request
	if !decodeJSON(w, r, &input) {
		return
	}
	if strings.TrimSpace(input.Name) == "" {
		response.SendError(w, apperrors.BadRequest("name is required"))
		return
	}
	response.SendSuccess(w, http.StatusCreated, "{{ .Pascal }} created", h.service.Create(input), nil)
}

func (h *Handler) List(w http.ResponseWriter, r *http.Request) {
	response.SendSuccess(w, http.StatusOK, "{{ .Pascal }} list", h.service.List(), nil)
}

func (h *Handler) Get(w http.ResponseWriter, r *http.Request) {
	item, ok := h.service.Get(r.PathValue("id"))
	if !ok {
		response.SendError(w, apperrors.NotFound("{{ .Pascal }} not found"))
		return
	}
	response.SendSuccess(w, http.StatusOK, "{{ .Pascal }} found", item, nil)
}

func (h *Handler) Update(w http.ResponseWriter, r *http.Request) {
	var input Update{{ .Pascal }}Request
	if !decodeJSON(w, r, &input) {
		return
	}
	if strings.TrimSpace(input.Name) == "" {
		response.SendError(w, apperrors.BadRequest("name is required"))
		return
	}
	item, ok := h.service.Update(r.PathValue("id"), input)
	if !ok {
		response.SendError(w, apperrors.NotFound("{{ .Pascal }} not found"))
		return
	}
	response.SendSuccess(w, http.StatusOK, "{{ .Pascal }} updated", item, nil)
}

func (h *Handler) Delete(w http.ResponseWriter, r *http.Request) {
	if !h.service.Delete(r.PathValue("id")) {
		response.SendError(w, apperrors.NotFound("{{ .Pascal }} not found"))
		return
	}
	response.SendSuccess(w, http.StatusOK, "{{ .Pascal }} deleted", nil, nil)
}

func (h *Handler) Health(w http.ResponseWriter, r *http.Request) {
	response.SendSuccess(w, http.StatusOK, "{{ .Pascal }} healthy", map[string]string{"status": "ok"}, nil)
}

func decodeJSON(w http.ResponseWriter, r *http.Request, target any) bool {
	decoder := json.NewDecoder(r.Body)
	decoder.DisallowUnknownFields()
	if err := decoder.Decode(target); err != nil {
		response.SendError(w, apperrors.BadRequest("invalid JSON request body"))
		return false
	}
	return true
}
