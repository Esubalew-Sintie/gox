{{ if eq .Storage.Driver "postgres" }}
# PostgreSQL connection string used by initiator/dependencies.go.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
{{ else if eq .Storage.Driver "mongo" }}
# MongoDB connection settings used by initiator/dependencies.go.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=app
{{ else }}
# Memory persistence is selected. No database configuration is required.
{{ end }}
