package initiator

import (
	"context"
	"log"
	"net/http"
	"os"
	"os/signal"
	"syscall"
)

func Initiator() {
	cfg := LoadConfig()
	dependencies, err := InitDependencies(context.Background())
	if err != nil {
		log.Fatalf("initialize dependencies: %v", err)
	}

	persistence := InitPersistence()
	modules := InitModule(persistence)
	handlers := InitHandler(modules)
	router := InitRoutes(handlers)
	server := &http.Server{
		Addr:    ":" + cfg.Port,
		Handler: router,
	}

	signals := make(chan os.Signal, 1)
	signal.Notify(signals, os.Interrupt, syscall.SIGTERM)

	go func() {
		log.Printf("server listening on %s", server.Addr)
		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Printf("server stopped with error: %v", err)
			signals <- syscall.SIGTERM
		}
	}()

	<-signals
	ctx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
	defer cancel()

	if err := server.Shutdown(ctx); err != nil {
		log.Printf("graceful shutdown failed: %v", err)
	}
	if err := dependencies.Close(ctx); err != nil {
		log.Printf("dependency shutdown failed: %v", err)
	}
}
