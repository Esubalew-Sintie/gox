package initiator

import (
{{ if ne .HTTP "gin" }}
	"log"
	"net/http"
	"time"
{{ else }}
	"net/http"

	"github.com/gin-gonic/gin"
{{ end }}
{{ if eq .HTTP "chi" }}
	"github.com/go-chi/chi/v5"
{{ end }}

	// gox:imports:start
	// gox:imports:end
)

func InitRoutes(handlers Handler) http.Handler {
{{ if eq .HTTP "net/http" }}
	router := http.NewServeMux()
	router.HandleFunc("GET /healthz", health)
	router.HandleFunc("GET /readyz", health)
{{ else if eq .HTTP "chi" }}
	router := chi.NewRouter()
	router.Get("/healthz", health)
	router.Get("/readyz", health)
{{ else }}
	router := gin.New()
	router.Use(gin.Logger(), gin.Recovery())
	router.GET("/healthz", ginHealth)
	router.GET("/readyz", ginHealth)
{{ end }}

	// gox:init:start
	// gox:init:end

{{ if eq .HTTP "gin" }}
	return router
{{ else }}
	return requestLogger(router)
{{ end }}
}

{{ if ne .HTTP "gin" }}
func health(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	_, _ = w.Write([]byte("{\"status\":\"ok\"}\n"))
}

func requestLogger(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		started := time.Now()
		next.ServeHTTP(w, r)
		log.Printf("%s %s duration=%s", r.Method, r.URL.Path, time.Since(started))
	})
}
{{ else }}
func ginHealth(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{"status": "ok"})
}
{{ end }}
