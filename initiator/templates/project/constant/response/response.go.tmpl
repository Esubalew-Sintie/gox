package response

import (
	"encoding/json"
	"net/http"

	apperrors "{{ .Module }}/internal/constant/errors"
)

func SendSuccess(w http.ResponseWriter, status int, message string, data, meta any) {
	write(w, status, Model{
		Status:  status,
		Message: message,
		Data:    data,
		Meta:    meta,
	})
}

func SendError(w http.ResponseWriter, err error) {
	status, errorType, message := apperrors.Metadata(err)
	write(w, status, Model{
		Status: status,
		Error: &Error{Type: errorType, Message: message},
	})
}

func write(w http.ResponseWriter, status int, payload Model) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(payload)
}
