package errors

import (
	"errors"
	"net/http"
)

type Type string

const (
	TypeValidation Type = "validation"
	TypeNotFound   Type = "not_found"
	TypeInternal   Type = "internal"
)

type AppError struct {
	Message string
	Status  int
	Type    Type
}

func (e *AppError) Error() string {
	return e.Message
}

func BadRequest(message string) *AppError {
	return &AppError{Message: message, Status: http.StatusBadRequest, Type: TypeValidation}
}

func NotFound(message string) *AppError {
	return &AppError{Message: message, Status: http.StatusNotFound, Type: TypeNotFound}
}

func Internal(message string) *AppError {
	return &AppError{Message: message, Status: http.StatusInternalServerError, Type: TypeInternal}
}

func Metadata(err error) (int, Type, string) {
	var appError *AppError
	if errors.As(err, &appError) {
		return appError.Status, appError.Type, appError.Message
	}
	return http.StatusInternalServerError, TypeInternal, "internal server error"
}
