// Package dbtest starts real databases for repository tests. It uses
// testcontainers, so it needs Docker; tests skip it under -short.
package dbtest

import (
	"context"
	"fmt"

	"github.com/testcontainers/testcontainers-go"
	tcmongo "github.com/testcontainers/testcontainers-go/modules/mongodb"
	"go.mongodb.org/mongo-driver/v2/mongo"

	"{{ .Module }}/internal/config"
	mongostorage "{{ .Module }}/internal/storage/mongo"
)

// MongoImage is the container image repository tests run against.
const MongoImage = "mongo:8"

// StartMongo starts a MongoDB container and returns a database and a stop
// function. Call it from TestMain so one container serves the whole test
// package.
func StartMongo(ctx context.Context) (*mongo.Database, func(), error) {
	ctr, err := tcmongo.Run(ctx, MongoImage)
	if err != nil {
		return nil, nil, fmt.Errorf("start mongo container: %w", err)
	}
	stop := func() { _ = testcontainers.TerminateContainer(ctr) }

	uri, err := ctr.ConnectionString(ctx)
	if err != nil {
		stop()
		return nil, nil, fmt.Errorf("mongo connection string: %w", err)
	}
	db, err := mongostorage.Connect(ctx, config.MongoConfig{URI: uri, Database: "test"})
	if err != nil {
		stop()
		return nil, nil, err
	}
	return db, func() { _ = db.Client().Disconnect(context.Background()); stop() }, nil
}
