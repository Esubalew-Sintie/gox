// Package dbtest starts real databases for repository tests. It uses
// testcontainers, so it needs Docker; tests skip it under -short.
package dbtest

import (
	"context"
	"fmt"
	"io/fs"

	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/testcontainers/testcontainers-go"
	tcpostgres "github.com/testcontainers/testcontainers-go/modules/postgres"

	"{{ .Module }}/internal/config"
	"{{ .Module }}/internal/storage/postgres"
)

// PostgresImage is the container image repository tests run against.
const PostgresImage = "postgres:17-alpine"

// StartPostgres starts a Postgres container, applies the migrations in fsys
// and returns the pool and a stop function. Call it from TestMain so one
// container serves the whole test package.
func StartPostgres(ctx context.Context, fsys fs.FS) (*pgxpool.Pool, func(), error) {
	ctr, err := tcpostgres.Run(ctx, PostgresImage,
		tcpostgres.WithDatabase("test"),
		tcpostgres.WithUsername("test"),
		tcpostgres.WithPassword("test"),
		tcpostgres.BasicWaitStrategies(),
	)
	if err != nil {
		return nil, nil, fmt.Errorf("start postgres container: %w", err)
	}
	stop := func() { _ = testcontainers.TerminateContainer(ctr) }

	url, err := ctr.ConnectionString(ctx, "sslmode=disable")
	if err != nil {
		stop()
		return nil, nil, fmt.Errorf("postgres connection string: %w", err)
	}
	pool, err := postgres.NewPool(ctx, config.PostgresConfig{URL: url})
	if err != nil {
		stop()
		return nil, nil, err
	}
	if err := postgres.Migrate(pool, fsys); err != nil {
		pool.Close()
		stop()
		return nil, nil, err
	}
	return pool, func() { pool.Close(); stop() }, nil
}
