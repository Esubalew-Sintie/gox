func TestCreateValidation(t *testing.T) {
	body := validBody()
	body["{{ (index . 0).Name.Snake }}"] = ""
	code, out := do(t, newRoutes(), http.MethodPost, listPath, body)
	e, _ := out["error"].(map[string]any)
	if code != http.StatusBadRequest || e["type"] != "validation" {
		t.Fatalf("validation: %d %v", code, out)
	}
}
