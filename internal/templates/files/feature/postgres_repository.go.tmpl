// Package {{ .Name.Snake }} is the Postgres implementation of storage.{{ .Name.Pascal }}Repository.
package {{ .Name.Snake }}

import (
	"context"
	"errors"
	"log/slog"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"

	"{{ .Module }}/internal/domain"
	"{{ .Module }}/internal/domain/entity"
	"{{ .Module }}/internal/storage"
	"{{ .Module }}/internal/storage/postgres"
)

const (
	insertSQL          = `{{ .SQL.Insert }}`
	selectSQL          = `{{ .SQL.Select }}`
	selectForUpdateSQL = `{{ .SQL.SelectForUpdate }}`
	listSQL            = `{{ .SQL.List }}`
	countSQL           = `{{ .SQL.Count }}`
	updateSQL          = `{{ .SQL.Update }}`
	deleteSQL          = `{{ .SQL.Delete }}`
)

// Repository stores {{ .PluralTitle | lower }} in the {{ .SQL.Table }} table.
type Repository struct {
	pool *pgxpool.Pool
	log  *slog.Logger
}

var _ storage.{{ .Name.Pascal }}Repository = (*Repository)(nil)

// New wires the repository to the pool.
func New(pool *pgxpool.Pool, log *slog.Logger) *Repository {
	return &Repository{pool: pool, log: log}
}

// Create inserts e, assigning an id when it has none.
func (r *Repository) Create(ctx context.Context, e *entity.{{ .Name.Pascal }}) error {
	if e.ID == "" {
		e.ID = domain.NewID()
	}
	_, err := r.pool.Exec(ctx, insertSQL, {{ .InsertArgs }})
	return translate(err)
}

// Get returns one {{ .Title | lower }} by id.
func (r *Repository) Get(ctx context.Context, id string) (*entity.{{ .Name.Pascal }}, error) {
	return scan(r.pool.QueryRow(ctx, selectSQL, id))
}

// List returns one page in creation order and the total count.
func (r *Repository) List(ctx context.Context, page domain.PageRequest) ([]*entity.{{ .Name.Pascal }}, int64, error) {
	page = page.Normalized()
	var total int64
	if err := r.pool.QueryRow(ctx, countSQL).Scan(&total); err != nil {
		return nil, 0, translate(err)
	}
	rows, err := r.pool.Query(ctx, listSQL, page.Limit, page.Offset())
	if err != nil {
		return nil, 0, translate(err)
	}
	defer rows.Close()
	items := make([]*entity.{{ .Name.Pascal }}, 0, page.Limit)
	for rows.Next() {
		e, err := scan(rows)
		if err != nil {
			return nil, 0, err
		}
		items = append(items, e)
	}
	if err := rows.Err(); err != nil {
		return nil, 0, translate(err)
	}
	return items, total, nil
}

// Update locks the row, applies fn and writes the result in one transaction.
func (r *Repository) Update(ctx context.Context, id string, fn func(*entity.{{ .Name.Pascal }}) error) (*entity.{{ .Name.Pascal }}, error) {
	var out *entity.{{ .Name.Pascal }}
	err := postgres.WithTx(ctx, r.pool, func(tx pgx.Tx) error {
		e, err := scan(tx.QueryRow(ctx, selectForUpdateSQL, id))
		if err != nil {
			return err
		}
		if err := fn(e); err != nil {
			return err
		}
		if _, err := tx.Exec(ctx, updateSQL, {{ .UpdateArgs }}); err != nil {
			return translate(err)
		}
		out = e
		return nil
	})
	if err != nil {
		return nil, err
	}
	return out, nil
}

// Delete removes one {{ .Title | lower }}.
func (r *Repository) Delete(ctx context.Context, id string) error {
	tag, err := r.pool.Exec(ctx, deleteSQL, id)
	if err != nil {
		return translate(err)
	}
	if tag.RowsAffected() == 0 {
		return domain.Err{{ .Name.Pascal }}NotFound
	}
	return nil
}

func scan(row pgx.Row) (*entity.{{ .Name.Pascal }}, error) {
	var e entity.{{ .Name.Pascal }}
	if err := row.Scan({{ .ScanArgs }}); err != nil {
		return nil, translate(err)
	}
	return &e, nil
}

// translate maps driver errors to the catalogue; a unique violation becomes
// the feature's conflict error.
func translate(err error) error {
	if err == nil {
		return nil
	}
	err = postgres.Translate(err, domain.Err{{ .Name.Pascal }}NotFound)
	if errors.Is(err, domain.ErrConflict) {
		return domain.Wrap(domain.Err{{ .Name.Pascal }}Conflict, err)
	}
	return err
}
