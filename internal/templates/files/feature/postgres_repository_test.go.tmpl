var pool *pgxpool.Pool

// TestMain starts one Postgres container for the package. Under -short the
// tests skip themselves and no container is started.
func TestMain(m *testing.M) {
	flag.Parse()
	if testing.Short() {
		os.Exit(m.Run())
	}
	ctx := context.Background()
	p, stop, err := dbtest.StartPostgres(ctx, migrations.FS)
	if err != nil {
		fmt.Fprintln(os.Stderr, "start postgres:", err)
		os.Exit(1)
	}
	pool = p
	code := m.Run()
	stop()
	os.Exit(code)
}

func newRepo(t *testing.T) *{{ .Name.Snake }}repo.Repository {
	t.Helper()
	if testing.Short() {
		t.Skip("needs Docker; run without -short")
	}
	if _, err := pool.Exec(context.Background(), "TRUNCATE {{ .SQL.Table }}"); err != nil {
		t.Fatal(err)
	}
	return {{ .Name.Snake }}repo.New(pool, slog.Default())
}

