package app

import (
	"log/slog"
	"os"

	"{{ .Module }}/internal/config"
)

// InitLogger builds the process logger and installs it as slog.Default,
// which response.Error and the middleware use.
func InitLogger(cfg *config.Config) *slog.Logger {
	var level slog.Level
	if err := level.UnmarshalText([]byte(cfg.Server.LogLevel)); err != nil {
		level = slog.LevelInfo
	}
	log := slog.New(slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{Level: level})).With("service", "{{ .Name }}")
	slog.SetDefault(log)
	return log
}
