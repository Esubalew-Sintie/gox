# Environment overrides for {{ .Name }}. Copy to .env for local use; .env is git-ignored.
# A double underscore separates levels: APP_SERVER__PORT sets server.port in config.yaml.
APP_SERVER__PORT=8080
APP_SERVER__ENVIRONMENT=development
APP_SERVER__LOG_LEVEL=info
{{- if .Postgres }}
APP_POSTGRES__URL=postgres://app:app@localhost:5432/app?sslmode=disable
{{- end }}
{{- if .MySQL }}
APP_MYSQL__DSN=app:app@tcp(localhost:3306)/app?parseTime=true&multiStatements=true
{{- end }}
{{- if .SQLite }}
APP_SQLITE__PATH=data/{{ .Name }}.db
{{- end }}
{{- if .Mongo }}
APP_MONGO__URI=mongodb://localhost:27017
APP_MONGO__DATABASE={{ .Name }}
{{- end }}
