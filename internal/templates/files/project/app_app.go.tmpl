// Package app is the composition root. app.go is the only file that knows
// the order in which the service is assembled; everything it calls lives in
// its own file so each concern can be tuned by hand. The Init functions in
// infra.go, external_api.go, storage.go, cache.go, service.go, handler.go and
// routes.go are regenerated by gox and keep their signatures.
package app

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net"
	"net/http"
	"strconv"

	"github.com/go-chi/chi/v5"

	"{{ .Module }}/internal/config"
	"{{ .Module }}/internal/handler/http/middleware"
)

// Initialize assembles the service and serves it until ctx is cancelled.
func Initialize(ctx context.Context) error {
	cfg, err := InitConfig()
	if err != nil {
		return err
	}
	log := InitLogger(cfg)

	infra, err := InitInfra(ctx, cfg, log)
	if err != nil {
		return err
	}
	defer infra.Close(context.Background(), log)

	externalAPI := InitExternalAPI(cfg, infra, log)
	storage := InitStorage(infra, log)
	cache := InitCache(infra, log)
	service := InitService(storage, cache, externalAPI, infra, cfg, log)
	handler := InitHandler(service, log)

{{- if .Chi }}
	r := chi.NewRouter()
	r.Use(middleware.Logger(log), middleware.Recovery(log))
	InitRoutes(r, handler, infra)

	return serve(ctx, cfg, r, log)
{{- else }}
	mux := http.NewServeMux()
	InitRoutes(mux, handler, infra)
	var h http.Handler = mux
	h = middleware.Recovery(log)(h)
	h = middleware.Logger(log)(h)

	return serve(ctx, cfg, h, log)
{{- end }}
}

// serve runs the HTTP server and shuts it down gracefully when ctx ends.
func serve(ctx context.Context, cfg *config.Config, h http.Handler, log *slog.Logger) error {
	srv := &http.Server{
		Addr:              net.JoinHostPort("", strconv.Itoa(cfg.Server.Port)),
		Handler:           h,
		ReadHeaderTimeout: cfg.Server.ReadTimeout,
		ReadTimeout:       cfg.Server.ReadTimeout,
		WriteTimeout:      cfg.Server.WriteTimeout,
		BaseContext:       func(net.Listener) context.Context { return ctx },
	}

	errCh := make(chan error, 1)
	go func() {
		log.Info("server listening", "addr", srv.Addr, "environment", cfg.Server.Environment)
		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			errCh <- err
		}
		close(errCh)
	}()

	select {
	case err := <-errCh:
		if err != nil {
			return fmt.Errorf("serve: %w", err)
		}
		return nil
	case <-ctx.Done():
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), cfg.Server.ShutdownTimeout)
	defer cancel()
	log.Info("server shutting down")
	if err := srv.Shutdown(shutdownCtx); err != nil {
		return fmt.Errorf("shutdown: %w", err)
	}
	return nil
}
