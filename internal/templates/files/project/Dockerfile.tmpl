FROM golang:{{ .GoVersion }}-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/{{ .Name }} ./cmd

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/{{ .Name }} /app/{{ .Name }}
COPY config.yaml /app/config.yaml
EXPOSE 8080
ENTRYPOINT ["/app/{{ .Name }}"]
