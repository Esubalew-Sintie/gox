# golangci-lint v2 configuration generated by gox. The depguard rules enforce the
# layer dependency rule: domain imports nothing of the service, implementations
# depend on interfaces, and only app knows concrete types.
version: "2"

run:
  timeout: 5m

linters:
  default: standard
  enable:
    - depguard
    - errorlint
    - misspell
  settings:
    staticcheck:
      # ST1005 is off because the error catalogue holds user-facing sentences.
      checks: ["all", "-ST1000", "-ST1003", "-ST1005", "-ST1016", "-ST1020", "-ST1021", "-ST1022"]
    depguard:
      rules:
        domain:
          files:
            - "**/internal/domain/**"
          deny:
            - pkg: "{{ .Module }}/internal/service"
              desc: domain must not import the service layer
            - pkg: "{{ .Module }}/internal/handler"
              desc: domain must not import the handler layer
            - pkg: "{{ .Module }}/internal/storage"
              desc: domain must not import the storage layer
            - pkg: "{{ .Module }}/app"
              desc: domain must not import the composition root
        service:
          files:
            - "**/internal/service/**"
            - "!$test"
          deny:
            - pkg: "{{ .Module }}/internal/handler"
              desc: services must not import handlers
            - pkg: "{{ .Module }}/internal/storage/"
              desc: services depend on storage interfaces, not on adapters
            - pkg: "{{ .Module }}/app"
              desc: services must not import the composition root
        handler:
          files:
            - "**/internal/handler/**"
            - "!$test"
          deny:
            - pkg: "{{ .Module }}/internal/storage"
              desc: handlers must not import storage
            - pkg: "{{ .Module }}/internal/service/"
              desc: handlers depend on service interfaces, not on implementations
            - pkg: "{{ .Module }}/app"
              desc: handlers must not import the composition root

formatters:
  enable:
    - gofmt
    - goimports
  settings:
    goimports:
      local-prefixes:
        - "{{ .Module }}"
